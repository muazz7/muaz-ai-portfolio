# ---------------------------------------------------------------------------
# AI provider configuration
# ---------------------------------------------------------------------------
# The site works WITHOUT any key (it falls back to a local, retrieval-only
# answering engine). Add a key to get real, fluent LLM answers.
#
# AI_PROVIDER options: google | groq | xai | openai | openrouter | deepseek | custom
#
# AI_MODEL accepts a comma-separated fallback chain, tried in order. This
# matters on free tiers, where quota is metered per model and can be as low as
# ~20 requests per day.
#
# Recommended (free tier, good tool calling, ~1s replies):
#   AI_PROVIDER=google
#   AI_MODEL=gemini-3.5-flash-lite,gemini-3.5-flash
#   Get a key at https://aistudio.google.com/apikey
#   Note: gemini-2.5-flash is retired for new keys. Prefer a 3.x flash model.
#   Note: full "flash" models reason before replying (~10-19s). "lite" is ~1s.
#
# Also great and free (keys start with `gsk_`):
#   AI_PROVIDER=groq
#   AI_MODEL=llama-3.3-70b-versatile
#   Get a key at https://console.groq.com/keys
#
# Paid only, no free tier (keys start with `xai-`):
#   AI_PROVIDER=xai
#   AI_MODEL=grok-4-fast-non-reasoning
#
# Paid / highest quality:
#   AI_PROVIDER=openai
#   AI_MODEL=gpt-4.1-mini
# ---------------------------------------------------------------------------

AI_PROVIDER=google
AI_MODEL=gemini-3.5-flash-lite,gemini-flash-lite-latest,gemini-3.5-flash,gemini-flash-latest
AI_API_KEY=

# Only needed when AI_PROVIDER=custom (any OpenAI-compatible endpoint)
# AI_BASE_URL=https://your-endpoint/v1

# ---------------------------------------------------------------------------
# Backup providers (optional)
# ---------------------------------------------------------------------------
# Any provider key set here is appended to the fallback chain automatically.
# When the primary provider runs out of daily quota the next one takes over, so
# visitors keep getting fluent answers instead of dropping to retrieval-only.
# GROQ_API_KEY=
# XAI_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# DEEPSEEK_API_KEY=

# ---------------------------------------------------------------------------
# Optional tuning
# ---------------------------------------------------------------------------
# Messages allowed per IP per hour before the API starts refusing.
RATE_LIMIT_PER_HOUR=60

# Public site URL, used for metadata / OpenGraph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
